# Database
DATABASE_URL=postgresql+asyncpg://sidewalk:sidewalk@localhost:5432/sidewalk_dev

# Security & Auth
SECRET_KEY=replace-me-with-a-long-random-string-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Server
ENVIRONMENT=development
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
